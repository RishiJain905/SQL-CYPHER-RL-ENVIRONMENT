# NFL-RL's secrets: variable NAMES only, never values. Copy to `.env` (git-ignored) and fill in.
# Loaded only by `src/sqlrl/secrets.py` as Pydantic SecretStr; `python -m sqlrl.doctor` reports
# set / not set without showing a value.

# Run 3's teacher (design 3.5): a hosted model through OpenRouter. Spending needs Rishi's OK.
OPENROUTER_API_KEY=

# Optional: a stored `wandb login` works too.
WANDB_API_KEY=

# Optional: uploads and gated models; a stored `huggingface-cli login` works too.
HF_TOKEN=
